@font-face {
  font-family: 'Noto Naskh Arabic';
  font-style: normal;
  font-weight: 300;
  font-display: swap;
  src: url('/public/fonts/notonaskh/NotoNaskhArabic-Light.woff2') format('woff2'),
       url('/public/fonts/notonaskh/NotoNaskhArabic-Light.woff') format('woff');
  unicode-range: U+0600-06FF, U+0750-077F, U+08A0-08FF, U+FB50-FDFF, U+FE70-FEFF;
}

@font-face {
  font-family: 'Noto Naskh Arabic';
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url('/public/fonts/notonaskh/NotoNaskhArabic-Regular.woff2') format('woff2'),
       url('/public/fonts/notonaskh/NotoNaskhArabic-Regular.woff') format('woff');
  unicode-range: U+0600-06FF, U+0750-077F, U+08A0-08FF, U+FB50-FDFF, U+FE70-FEFF;
}

@font-face {
  font-family: 'Noto Naskh Arabic';
  font-style: normal;
  font-weight: 600;
  font-display: swap;
  src: url('/public/fonts/notonaskh/NotoNaskhArabic-SemiBold.woff2') format('woff2'),
       url('/public/fonts/notonaskh/NotoNaskhArabic-SemiBold.woff') format('woff');
  unicode-range: U+0600-06FF, U+0750-077F, U+08A0-08FF, U+FB50-FDFF, U+FE70-FEFF;
}

@font-face {
  font-family: 'Noto Naskh Arabic';
  font-style: normal;
  font-weight: 700;
  font-display: swap;
  src: url('/public/fonts/notonaskh/NotoNaskhArabic-Bold.woff2') format('woff2'),
       url('/public/fonts/notonaskh/NotoNaskhArabic-Bold.woff') format('woff');
  unicode-range: U+0600-06FF, U+0750-077F, U+08A0-08FF, U+FB50-FDFF, U+FE70-FEFF;
}

html, body, input, textarea, select, button {
  font-family: 'Noto Naskh Arabic', 'Noto Sans Arabic', sans-serif;
}
  
